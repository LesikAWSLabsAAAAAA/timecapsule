{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTimecapsuleDatabaseSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-central-1:<account>:secret:timecapsule-dev-db-6KgFVc",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}
