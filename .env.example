# Copy to .env and adjust:  cp .env.example .env
# The file is read by phpdotenv. Real environment variables (e.g. from docker-compose)
# always win over this file.

# Only used by docker-compose / documentation; PHP itself does not listen on a port.
APP_PORT=8080
APP_URL=http://localhost:8080
# true = show error details on the 500 page (never in production)
APP_DEBUG=false

# PostgreSQL connection.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timecapsule
DB_USER=timecapsule

# Preferred in AWS: ARN of the Secrets Manager secret that contains
# {"password":"..."}. When set, DB_PASSWORD is ignored and the instance role
# must allow secretsmanager:GetSecretValue on this secret.
DB_SECRET_ARN=

# Local development / docker-compose fallback only. Do not bake a real
# password into an AMI.
DB_PASSWORD=secret

# Cache the fetched secret in memory (tmpfs). 0 disables the cache; a short
# TTL limits the impact of a Secrets Manager outage and of password rotation.
SECRET_CACHE_TTL_SECONDS=300
SECRET_CACHE_DIR=/dev/shm
SECRET_FETCH_TIMEOUT_SECONDS=2

# Uploads are stored on the local disk. Relative paths start at the project root.
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5

# How long the fake "send e-mail" step takes when a capsule is sealed.
MAIL_DELAY_SECONDS=3
# Standard SNS topic; EC2 obtains AWS credentials from its instance role.
EVENTS_TOPIC_ARN=
AWS_REGION=eu-central-1

# false = no login; everybody uses the app as the built-in Guest user.
AUTH_ENABLED=true
# For multiple app servers, set this to the shared DynamoDB sessions table.
DYNAMODB_SESSION_TABLE=
